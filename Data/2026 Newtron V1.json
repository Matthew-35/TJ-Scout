    "sections": [
        {
            "name": "Prematch",
            "fields": [
                {
                    "title": "Scouter Initials",
                    "description": "Enter the initials of the scouter.",
                    "type": "text",
                    "required": true,
                    "code": "scouter",
                    "formResetBehavior": "preserve",
                    "defaultValue": ""
                },
                {
                    "title": "Match Number",
                    "description": "Select the match number.",
                    "type": "TBA-match-number",
                    "required": true,
                    "code": "matchNumber",
                    "formResetBehavior": "increment",
                    "defaultValue": 1
                },
                {
                    "title": "Team and Robot",
                    "description": "Select the team and robot position you are scouting.",
                    "type": "TBA-team-and-robot",
                    "required": true,
                    "code": "robot",
                    "formResetBehavior": "preserve",
                    "defaultValue": null
                },
                {
                    "title": "Starting Position",
                    "description": "The starting position of the robot.",
                    "type": "select",
                    "required": true,
                    "code": "startPos",
                    "formResetBehavior": "reset",
                    "defaultValue": "",
                    "choices": {
                        "OT": "Outpost Trench",
                        "OBFT": "Outpost Bump Favoring Trench",
                        "OBFH": "Outpost Bump Favoring Hub",
                        "H": "Hub",
                        "DBFH": "Depot Bump Favoring Hub",
                        "DBFT": "Depot Bump Favoring Trench",
                        "DT": "Depot Trench",
                        "N/A": "N/A"
                    }
                },
                {
                    "title": "No Show",
                    "description": "Check if the robot did not show up for the match.",
                    "type": "boolean",
                    "required": false,
                    "code": "noShow",
                    "formResetBehavior": "reset",
                    "defaultValue": false
                }
            ]
        },
        {
            "name": "Auto",
            "fields": [
                {
                    "title": "Auto Rating",
                    "description": "Rate the robot's autonomous performance.",
                    "type": "select",
                    "required": true,
                    "code": "autoRating",
                    "formResetBehavior": "reset",
                    "defaultValue": "",
                    "choices": {
                        "1": "1 - Best",
                        "2": "2",
                        "3": "3",
                        "4": "4",
                        "5": "5 - Worst (no auto)",
                        "N/A": "N/A (no show)"
                    }
                },
                {
                    "title": "How Many Swipes?",
                    "description": "How many swipes did the robot complete in auto?",
                    "type": "select",
                    "required": true,
                    "code": "autoSwipes",
                    "formResetBehavior": "reset",
                    "defaultValue": "",
                    "choices": {
                        "0": "0",
                        "1": "1",
                        "2": "2",
                        "0.5": "0.5",
                        "1.5": "1.5",
                        "2.5": "2.5"
                    }
                }
            ]
        },
        {
            "name": "Review",
            "fields": [
                {
                    "title": "Offense Rating",
                    "description": "Rate the offensive performance of the robot.",
                    "type": "select",
                    "required": true,
                    "code": "offRating",
                    "formResetBehavior": "reset",
                    "defaultValue": "",
                    "choices": {
                        "1": "1 - Best",
                        "2": "2",
                        "3": "3",
                        "4": "4",
                        "5": "5 - Worst",
                        "N/A": "N/A"
                    }
                },
                {
                    "title": "Defense Rating",
                    "description": "Rate the defensive performance of the robot.",
                    "type": "select",
                    "required": true,
                    "code": "defRating",
                    "formResetBehavior": "reset",
                    "defaultValue": "",
                    "choices": {
                        "1": "1 - Best",
                        "2": "2",
                        "3": "3",
                        "4": "4",
                        "5": "5 - Worst",
                        "N/A": "N/A"
                    }
                },
                {
                    "title": "Shuttling Fuel",
                    "type": "boolean",
                    "required": false,
                    "code": "shuttledFuel",
                    "formResetBehavior": "reset",
                    "defaultValue": false
                },
                {
                    "title": "Inaccurate Shooting",
                    "type": "boolean",
                    "required": false,
                    "code": "inaccShooting",
                    "formResetBehavior": "reset",
                    "defaultValue": false
                },
                {
                    "title": "Broken Intake",
                    "type": "boolean",
                    "required": false,
                    "code": "brokenIntake",
                    "formResetBehavior": "reset",
                    "defaultValue": false
                },
                {
                    "title": "Beached on Bump/Fuel",
                    "type": "boolean",
                    "required": false,
                    "code": "beached",
                    "formResetBehavior": "reset",
                    "defaultValue": false
                },
                {
                    "title": "Died (Not Moving)",
                    "type": "boolean",
                    "required": false,
                    "code": "died",
                    "formResetBehavior": "reset",
                    "defaultValue": false
                },
                {
                    "title": "Hey! Watch This Match - It Was Awesome!",
                    "type": "boolean",
                    "required": false,
                    "code": "watchMatch",
                    "formResetBehavior": "reset",
                    "defaultValue": false
                },
                {
                    "title": "Comments",
                    "description": "Any additional comments about the robot.",
                    "type": "text",
                    "required": false,
                    "code": "comments",
                    "formResetBehavior": "reset",
                    "defaultValue": ""
                }
            ]
        }
    ]
